//@version=6
// Strategia "SMA + Bande" con direzione scelta dall'utente (Trend Long / Trend Short).
//
// TREND LONG
//   1. Una candela rossa chiude sotto la SMA      -> segnale armato
//   2. Una candela verde successiva chiude sopra   -> apertura LONG
//   3. Qualsiasi candela tocca la banda superiore  -> uscita in Take Profit
//   4. Qualsiasi candela tocca la banda inferiore  -> uscita in Stop Loss
//
// TREND SHORT
//   1. Una candela verde chiude sopra la SMA       -> segnale armato
//   2. Una candela rossa successiva chiude sotto   -> apertura SHORT
//   3. Qualsiasi candela tocca la banda inferiore  -> uscita in Take Profit
//   4. Qualsiasi candela tocca la banda superiore  -> uscita in Stop Loss
//
// Il colore della candela si conosce solo alla chiusura, quindi ingressi e uscite
// avvengono al prezzo di chiusura della candela che dà il segnale
// (process_orders_on_close = true). Nessun repaint: si usano solo candele chiuse.
//
// AUTOMAZIONE: ogni ordine porta un messaggio JSON in alert_message.
// Crea un alert sulla strategia e nel campo "Messaggio" scrivi soltanto:
//     {{strategy.order.alert_message}}
// Il webhook del bot riceverà il JSON corrispondente all'ordine eseguito.

strategy("SMA Bande Trend", overlay = true,
     process_orders_on_close = true,
     pyramiding = 0,
     initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100,
     commission_type = strategy.commission.percent,
     commission_value = 0.1,
     slippage = 0,
     max_labels_count = 500,
     max_lines_count = 500)

// ───────── Impostazioni ─────────
grpS = "Strategia"
trendMode = input.string("Trend Long", "Direzione", options = ["Trend Long", "Trend Short"], group = grpS)
length    = input.int(20, "Periodo SMA", minval = 1, group = grpS)
mult      = input.float(2.0, "Ampiezza bande (deviazioni standard)", minval = 0.1, step = 0.1, group = grpS)
src       = input.source(close, "Sorgente", group = grpS)

grpT = "Periodo di test"
useWindow = input.bool(false, "Limita il periodo", group = grpT)
startTime = input.time(timestamp("2023-01-01T00:00:00"), "Dal", group = grpT)
endTime   = input.time(timestamp("2099-12-31T00:00:00"), "Al", group = grpT)

grpG = "Grafica"
showBands = input.bool(true, "Mostra bande", group = grpG)
showArmed = input.bool(true, "Mostra segnale armato", group = grpG)

grpB = "Bot / Webhook"
botId = input.string("sma-bande", "ID strategia nel messaggio", group = grpB)

// ───────── Calcoli ─────────
basis = ta.sma(src, length)
dev   = mult * ta.stdev(src, length)
upper = basis + dev
lower = basis - dev

isGreen  = close > open
isRed    = close < open
isLong   = trendMode == "Trend Long"
inWindow = not useWindow or (time >= startTime and time <= endTime)

pos = strategy.position_size

// Uscite (valutate sulla candela appena chiusa, qualsiasi colore).
// Se la stessa candela tocca entrambe le bande vince lo Stop Loss (scelta prudente).
touchUp = high >= upper
touchLo = low  <= lower
longSL  = pos > 0 and touchLo
longTP  = pos > 0 and touchUp and not longSL
shortSL = pos < 0 and touchUp
shortTP = pos < 0 and touchLo and not shortSL
exitNow = longTP or longSL or shortTP or shortSL
isTP    = longTP or shortTP

// Preparazione e innesco dell'ingresso
armCond  = isLong ? (isRed and close < basis)   : (isGreen and close > basis)
trigCond = isLong ? (isGreen and close > basis) : (isRed and close < basis)

var bool armed = false
enterNow = pos == 0 and armed and trigCond and inWindow

if enterNow
    armed := false
else if armCond and inWindow and (pos == 0 or exitNow)
    // si arma solo quando si è (o si torna) flat su questa candela
    armed := true

// ───────── Messaggi per il bot ─────────
f_msg(string action) =>
    '{"id":"' + botId + '","azione":"' + action + '","simbolo":"' + syminfo.ticker +
     '","exchange":"' + syminfo.prefix + '","prezzo":"{{close}}","quantita":"{{strategy.order.contracts}}","tempo":"{{timenow}}"}'

// ───────── Ordini ─────────
if enterNow
    if isLong
        strategy.entry("Long", strategy.long, alert_message = f_msg("apri_long"))
    else
        strategy.entry("Short", strategy.short, alert_message = f_msg("apri_short"))

if longTP or longSL
    strategy.close("Long", comment = longTP ? "TP" : "SL", alert_message = f_msg(longTP ? "chiudi_long_tp" : "chiudi_long_sl"))

if shortTP or shortSL
    strategy.close("Short", comment = shortTP ? "TP" : "SL", alert_message = f_msg(shortTP ? "chiudi_short_tp" : "chiudi_short_sl"))

// ───────── Grafica ─────────
pBasis = plot(basis, "SMA", color = color.orange, linewidth = 2)
pUp    = plot(showBands ? upper : na, "Banda superiore", color = color.new(color.blue, 30))
pLo    = plot(showBands ? lower : na, "Banda inferiore", color = color.new(color.blue, 30))
fill(pUp, pLo, color = color.new(color.blue, 93), title = "Sfondo bande")

// Ingressi
plotshape(enterNow and isLong,  "Ingresso Long",  shape.triangleup,   location.belowbar, color.lime, size = size.small, text = "LONG",  textcolor = color.lime)
plotshape(enterNow and not isLong, "Ingresso Short", shape.triangledown, location.abovebar, color.fuchsia, size = size.small, text = "SHORT", textcolor = color.fuchsia)

// Segnale armato (in attesa della candela di conferma)
plotshape(showArmed and armed and pos == 0, "Segnale armato", shape.circle,
     isLong ? location.belowbar : location.abovebar, color.new(color.gray, 20), size = size.tiny)

// Uscite con percentuale del trade: verde se guadagno, rosso se perdita
if exitNow
    entryPx = strategy.position_avg_price
    dir     = pos > 0 ? 1.0 : -1.0
    pct     = (close / entryPx - 1.0) * 100.0 * dir
    win     = pct >= 0
    txt     = (isTP ? "TP " : "SL ") + (win ? "+" : "") + str.tostring(pct, "#.##") + "%"
    label.new(bar_index, pos > 0 ? high : low, txt,
         color = win ? color.new(color.green, 0) : color.new(color.red, 0),
         textcolor = color.white,
         style = pos > 0 ? label.style_label_down : label.style_label_up,
         size = size.normal,
         tooltip = "Ingresso: " + str.tostring(entryPx, format.mintick) + "\nUscita: " + str.tostring(close, format.mintick) + "\nPercentuale lorda (senza commissioni)")

// Linea che collega ingresso e uscita del trade
var float entryLinePx = na
var int   entryBar    = na
if enterNow
    entryLinePx := close
    entryBar    := bar_index
if exitNow and not na(entryBar)
    line.new(entryBar, entryLinePx, bar_index, close,
         color = ((close - entryLinePx) * (pos > 0 ? 1 : -1)) >= 0 ? color.green : color.red,
         style = line.style_dashed, width = 1)
    entryBar := na
